<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Calculator.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Calculator.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:WinUI.Button.Controls"
    mc:Ignorable="d"
    Title="Calculator.App">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- Display -->

        <Grid Grid.Row="0"
              Margin="0,0,0,16">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Expression -->

            <TextBlock
                Grid.Row="0"
                Text=""
                FontSize="16"
                HorizontalAlignment="Right"
                Opacity="0.7"/>

            <!-- Result -->

            <TextBlock
                Grid.Row="1"
                Text="0"
                FontSize="42"
                FontWeight="SemiBold"
                HorizontalAlignment="Right"
                Margin="0,8,0,0"/>

        </Grid>


        <!-- Keypad -->

        <Grid Grid.Row="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- Row 0 -->

            <controls:WUIButton
                Grid.Row="0"
                Grid.Column="0"
                Content="%"
                ButtonType="Function"/>

            <controls:WUIButton
                Grid.Row="0"
                Grid.Column="1"
                Content="CE"
                ButtonType="Function"/>

            <controls:WUIButton
                Grid.Row="0"
                Grid.Column="2"
                Content="C"
                ButtonType="Function"/>

            <controls:WUIButton
                Grid.Row="0"
                Grid.Column="3"
                Content="⌫"
                ButtonType="Function"/>


            <!-- Row 1 -->

            <controls:WUIButton
                Grid.Row="1"
                Grid.Column="0"
                Content="1/x"
                ButtonType="Function"/>

            <controls:WUIButton
                Grid.Row="1"
                Grid.Column="1"
                Content="x²"
                ButtonType="Function"/>

            <controls:WUIButton
                Grid.Row="1"
                Grid.Column="2"
                Content="√x"
                ButtonType="Function"/>

            <controls:WUIButton
                Grid.Row="1"
                Grid.Column="3"
                Content="÷"
                ButtonType="Operator"/>


            <!-- Row 2 -->

            <controls:WUIButton
                Grid.Row="2"
                Grid.Column="0"
                Content="7"
                ButtonType="Number"/>

            <controls:WUIButton
                Grid.Row="2"
                Grid.Column="1"
                Content="8"
                ButtonType="Number"/>

            <controls:WUIButton
                Grid.Row="2"
                Grid.Column="2"
                Content="9"
                ButtonType="Number"/>

            <controls:WUIButton
                Grid.Row="2"
                Grid.Column="3"
                Content="×"
                ButtonType="Operator"/>


            <!-- Row 3 -->

            <controls:WUIButton
                Grid.Row="3"
                Grid.Column="0"
                Content="4"
                ButtonType="Number"/>

            <controls:WUIButton
                Grid.Row="3"
                Grid.Column="1"
                Content="5"
                ButtonType="Number"/>

            <controls:WUIButton
                Grid.Row="3"
                Grid.Column="2"
                Content="6"
                ButtonType="Number"/>

            <controls:WUIButton
                Grid.Row="3"
                Grid.Column="3"
                Content="−"
                ButtonType="Operator"/>


            <!-- Row 4 -->

            <controls:WUIButton
                Grid.Row="4"
                Grid.Column="0"
                Content="1"
                ButtonType="Number"/>

            <controls:WUIButton
                Grid.Row="4"
                Grid.Column="1"
                Content="2"
                ButtonType="Number"/>

            <controls:WUIButton
                Grid.Row="4"
                Grid.Column="2"
                Content="3"
                ButtonType="Number"/>

            <controls:WUIButton
                Grid.Row="4"
                Grid.Column="3"
                Content="+"
                ButtonType="Operator"/>


            <!-- Row 5 -->

            <controls:WUIButton
                Grid.Row="5"
                Grid.Column="0"
                Content="±"
                ButtonType="Function"/>

            <controls:WUIButton
                Grid.Row="5"
                Grid.Column="1"
                Content="0"
                ButtonType="Number"/>

            <controls:WUIButton
                Grid.Row="5"
                Grid.Column="2"
                Content="."
                ButtonType="Number"/>

            <controls:WUIButton
                Grid.Row="5"
                Grid.Column="3"
                Content="="
                ButtonType="Equal"/>

        </Grid>

    </Grid>
</Window>
